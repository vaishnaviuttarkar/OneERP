# Copy to .env (cp .env.example .env). Development-only values - change before any real deployment.
DJANGO_SECRET_KEY=replace-with-your-own-django-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=your-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DEFAULT_BUSINESS_SLUG=

# ---- Email (GoDaddy Titan business mailbox) -------------------------------------------------
# Fill these in YOUR .env only. Never commit real credentials. Leave EMAIL_HOST empty in development:
# emails are then printed to the container log instead of being sent.
# EMAIL_HOST=
EMAIL_HOST=smtp.titan.email
EMAIL_PORT=465
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
# Titan: smtp.titan.email  -> port 465 with EMAIL_USE_SSL=True, or port 587 with EMAIL_USE_TLS=True / EMAIL_USE_SSL=False
BUSINESS_MAILBOX=your-email@gmail.com
DEFAULT_FROM_EMAIL=your-email@gmail.com
ENQUIRY_RATE_LIMIT_PER_HOUR=5
ENQUIRY_MIN_FILL_SECONDS=3
TRUST_PROXY_HEADERS=False
